# ── Database ────────────────────────────────────────────────────────────────
# Production: a Postgres connection string (Neon or Supabase, pooled URL).
# DATABASE_URL_UNPOOLED (set by the Neon integration) is used for migrations.
# Local dev: leave blank (or set "pglite:./.data/pglite") to use embedded Postgres.
DATABASE_URL=

# ── App ─────────────────────────────────────────────────────────────────────
# Public base URL, used in customer approval / tracking links inside emails.
# On Vercel this defaults to the production domain if left blank.
# Production: https://cosgolf.co.uk
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32+ random bytes. Used to sign/derive internal secrets. `openssl rand -base64 32`
AUTH_SECRET=
# Shows demo login hints on the sign-in page. Never enable in production.
DEMO_MODE=true

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Leave RESEND_API_KEY blank in development: emails are rendered, logged and
# recorded against the order as "sent (simulated)" without leaving the machine.
RESEND_API_KEY=
# Platform sending domain, verified in Resend. Each shop sends from
# <shop-slug>@EMAIL_FROM_DOMAIN with its own name, e.g.
#   "Desirable Golf" <desirable-golf@mail.cosgolf.co.uk>, replies to the shop.
# A shop can instead send from its own address (Store settings → "Send customer
# emails from") once that domain is also verified in Resend.
EMAIL_FROM_DOMAIN=mail.cosgolf.co.uk
# Fallback single sender if EMAIL_FROM_DOMAIN is blank.
EMAIL_FROM=
# Resend webhook signing secret (whsec_...) for delivery/bounce events.
RESEND_WEBHOOK_SECRET=

# ── Attachments & backups storage ───────────────────────────────────────────
# Leave STORAGE_DRIVER blank: on Vercel, connecting a Blob store adds
# BLOB_READ_WRITE_TOKEN and COS uses private Vercel Blob automatically.
# Locally it falls back to ./.data/uploads. Or set "s3" for any S3-compatible
# store (AWS S3, Cloudflare R2, Supabase Storage) with the S3_* settings below.
STORAGE_DRIVER=
STORAGE_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/daily.
CRON_SECRET=

# ── Backup export integrations (Pro tier, optional) ─────────────────────────
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
