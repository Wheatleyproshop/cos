{
  "name": "cos",
  "version": "1.0.0",
  "private": true,
  "description": "COS \u2014 Customer Order System for golf professional shops",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "vercel-build": "npm run db:migrate && next build",
    "shop:create": "tsx scripts/create-shop.ts",
    "plan:set": "tsx scripts/set-plan.ts",
    "backup:local": "tsx --env-file=.env.production.local scripts/backup-local.ts",
    "staff:add": "tsx --env-file=.env.production.local scripts/add-staff.ts",
    "catalogue:import": "tsx scripts/import-catalogue.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@electric-sql/pglite": "^0.5.10",
    "@fontsource/inter": "^5.3.0",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.33.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.5"
  }
}
